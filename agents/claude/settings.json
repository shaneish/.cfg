{
  "theme": "light",
  "editorMode": "vim",
  "permissions": {
    "allow": [
      "Bash(python3 -m py_compile *)",
      "Bash(python3 -m pip *)",
      "Bash(python3 -m venv *)",
      "Bash(python3 -m ensurepip)",
      "Bash(python3 -m pytest)",
      "Bash(python3 -m unittest)",
      "Bash(source */venv/bin/activate)",
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Read(*.env)",
      "Read(**/*.env)"
    ],
    "ask": [
      "Bash(git push:*)",
      "WebFetch"
    ]
  }
}
